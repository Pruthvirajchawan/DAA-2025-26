BFS :

#include <iostream>
#include <vector>
#include <queue>
#include <ctime>
using namespace std;

vector<int> g[100];
bool visited[100];

void BFS(int start)
{
    queue<int> q;
    q.push(start);
    visited[start] = true;
    while (!q.empty())
    {
        int node = q.front();
        q.pop();
        cout << node << " ";
        for (int next : g[node])
        {
            if (!visited[next])
            {
                visited[next] = true;
                q.push(next);
            }
        }
    }
}
int main()
{
    int n, e, u, v;
    cout << "Enter vertices and edges: ";
    cin >> n >> e;
    for (int i = 0; i < e; i++)
    {
        cin >> u >> v;
        g[u].push_back(v);
        g[v].push_back(u);
    }
    int start;
    cout << "Enter starting vertex: ";
    cin >> start;
    clock_t s = clock();
    BFS(start);
    clock_t end = clock();
    cout << "\nExecution Time: "
         << (double)(end - s) / CLOCKS_PER_SEC
         << " seconds";
    return 0;
}


DFS:


#include <iostream>
#include <vector>
#include <ctime>
using namespace std;

vector<int> g[100];
bool visited[100];
void DFS(int node)
{
    visited[node] = true;
    cout << node << " ";
    for (int next : g[node])
        if (!visited[next])
            DFS(next);
}
int main()
{
    int n, e, u, v;
    cout << "Enter vertices and edges: ";
    cin >> n >> e;
    for (int i = 0; i < e; i++)
    {
        cin >> u >> v;
        g[u].push_back(v);
        g[v].push_back(u);
    }
    int start;
    cout << "Enter starting vertex: ";
    cin >> start;
    clock_t s = clock();
    DFS(start);
    clock_t end = clock();
    cout << "\nExecution Time: "
         << (double)(end - s) / CLOCKS_PER_SEC
         << " seconds";
    return 0;
}
