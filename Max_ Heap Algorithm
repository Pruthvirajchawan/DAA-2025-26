#include <iostream>
#include <ctime>
using namespace std;
void heapify(int arr[], int n, int i)
{
    int largest = i;
    int left = 2 * i + 1;
    int right = 2 * i + 2;
    if (left < n && arr[left] > arr[largest])
        largest = left;
    if (right < n && arr[right] > arr[largest])
        largest = right;
    if (largest != i)
    {
        swap(arr[i], arr[largest]);
        heapify(arr, n, largest);
    }
}
int main()
{
    int n;
    cout << "Enter number of elements: ";
    cin >> n;
    int arr[n];
    cout << "Enter elements: ";
    for (int i = 0; i < n; i++)
        cin >> arr[i];
    clock_t start = clock();
    for (int i = n / 2 - 1; i >= 0; i--)
        heapify(arr, n, i);
    clock_t end = clock();
    cout << "Max Heap: ";
    for (int i = 0; i < n; i++)
        cout << arr[i] << " ";
    double time = (double)(end - start) / CLOCKS_PER_SEC;
    cout << endl;
    cout << "Execution Time = " << time << " seconds";
    return 0;
}
