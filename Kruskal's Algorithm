
#include <iostream>
#include <algorithm>
#include <ctime>
using namespace std;

int main()
{
    int n, e;
    int u[100], v[100], w[100];
    int parent[100];
    cout << "Enter vertices and edges: ";
    cin >> n >> e;
    for (int i = 0; i < e; i++)
    {
        cout << "Enter edge (u v weight): ";
        cin >> u[i] >> v[i] >> w[i];
    }
    clock_t start = clock();
    for (int i = 0; i < e - 1; i++)
        for (int j = 0; j < e - i - 1; j++)
            if (w[j] > w[j + 1])
            {
                swap(w[j], w[j + 1]);
                swap(u[j], u[j + 1]);
                swap(v[j], v[j + 1]);
            }
    for (int i = 0; i < n; i++)
        parent[i] = i;
    int cost = 0, count = 0;
    cout << "Selected edges:\n";
    for (int i = 0; i < e && count < n - 1; i++)
    {
        int a = u[i], b = v[i];
        while (parent[a] != a)
            a = parent[a];
        while (parent[b] != b)
            b = parent[b];
        if (a != b)
        {
            cout << u[i] << " - " << v[i]
                 << " : " << w[i] << endl;
            parent[a] = b;
            cost += w[i];
            count++;
        }
    }
    clock_t end = clock();
    if (count != n - 1)
        cout << "Graph is disconnected.\n";
    else
        cout << "Minimum Cost = " << cost << endl;
    cout << "Execution Time = "
         << (double)(end - start) / CLOCKS_PER_SEC
         << " seconds";
    return 0;
}
