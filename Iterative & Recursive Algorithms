Iterative:

#include <iostream>
#include <ctime>
using namespace std;

int main()
{
    int n, fact = 1;
    cout << "Enter a number: ";
    cin >> n;
    clock_t start = clock();  
    for (int i = 1; i <= n; i++)
        fact *= i;
    clock_t end = clock();
    cout << "Factorial = " << fact << endl;
    double time = (double)(end - start) / CLOCKS_PER_SEC;
    cout << "Execution Time = " << time << " seconds";
    return 0;
}


Recursive:

#include <iostream>
#include <ctime>
using namespace std;

int factorial(int n)
{
    if (n == 0 || n == 1)
        return 1;
    return n * factorial(n - 1);
}
int main()
{
    int n;
    cout << "Enter a number: ";
    cin >> n;
    clock_t start = clock();   
    int fact = factorial(n);
    clock_t end = clock();     
    cout << "Factorial = " << fact << endl;
    double time = (double)(end - start) / CLOCKS_PER_SEC;
    cout << "Execution Time = " << time << " seconds";
    return 0;
}
