Bubble Sort:

#include<iostream>
#include<ctime>
#include<iomanip>
using namespace std;

void bubble_sort(int arr[], int n)
{
    for(int i=n-1; i>=0; i--)
    {
        for(int j=0; j<=i-1; j++)
        {
            if(arr[j]>arr[j+1])
            {
                int temp=arr[j];
                arr[j]=arr[j+1];
                arr[j+1]=temp;
            }
        }
    }
}

int main()
{
    int n;
    cin>>n;

    int arr[n];
    for(int i=0;i<n;i++)
        cin>>arr[i];

    clock_t start = clock();
    bubble_sort(arr,n);
    clock_t end = clock();

    for(int i=0;i<n;i++)
        cout<<arr[i]<<" ";

    cout << "\nTime = " << fixed << setprecision(6)
         << (double)(end-start)/CLOCKS_PER_SEC
         << " seconds";

    return 0;
}
