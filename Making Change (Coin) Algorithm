#include <iostream>
#include <ctime>
using namespace std;

int main()
{
    int n, amount;
    cout << "Enter number of coins: ";
    cin >> n;
    int coin[n];
    cout << "Enter coins: ";
    for (int i = 0; i < n; i++)
        cin >> coin[i];
    cout << "Enter amount: ";
    cin >> amount;
    int dp[amount + 1];
    clock_t start = clock();
    dp[0] = 0;
    for (int i = 1; i <= amount; i++)
    {
        dp[i] = 999;
        for (int j = 0; j < n; j++)
        {
            if (coin[j] <= i)
                dp[i] = min(dp[i], dp[i - coin[j]] + 1);
        }
    }
    clock_t end = clock();
    cout << "Minimum coins = " << dp[amount] << endl;
    cout << "Time = "
         << (double)(end - start) / CLOCKS_PER_SEC
         << " seconds";
    return 0;
}
