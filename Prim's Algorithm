
#include <iostream>
#include <ctime>
using namespace std;

int main()
{
    int n, a[10][10], visited[10] = {0};
    int cost = 0, edges = 0;
    cout << "Enter number of vertices: ";
    cin >> n;
    cout << "Enter cost matrix (0 for no edge):\n";
    for (int i = 0; i < n; i++)
        for (int j = 0; j < n; j++)
            cin >> a[i][j];
    clock_t start = clock();
    visited[0] = 1;
    while (edges < n - 1)
    {
        int min = 9999, u = -1, v = -1;
        for (int i = 0; i < n; i++)
            for (int j = 0; j < n; j++)
                if (visited[i] && !visited[j] &&
                    a[i][j] != 0 && a[i][j] < min)
                {
                    min = a[i][j];
                    u = i;
                    v = j;
                }

        if (v == -1)
        {
            cout << "Graph is disconnected";
            return 0;
        }

        cout << u << " - " << v << " : " << min << endl;
        visited[v] = 1;
        cost += min;
        edges++;
    }
    clock_t end = clock();

    cout << "Minimum Cost = " << cost << endl;
    cout << "Execution Time = "
         << (double)(end - start) / CLOCKS_PER_SEC
         << " seconds";

    return 0;
}
